The static assets variable may not be the name of another generated declaration.

Command line: muxt generate --input-static-assets-directory=assets --output-static-assets-path=/static --output-template-data-type=templateRoutesStaticAssets
-- config.json --
{
	"MuxtVersion": "v1.2.3",
	"PackageName": "main",
	"PackagePath": "",
	"RoutesFunction": "TemplateRoutes",
	"ReceiverType": "",
	"ReceiverPackage": "",
	"ReceiverInterface": "RoutesReceiver",
	"TemplateDataType": "templateRoutesStaticAssets",
	"SSETemplateDataType": "SSETemplateData",
	"TemplateRoutePathsTypeName": "TemplateRoutePaths",
	"TemplatesVariables": [
		"templates"
	],
	"OutputFileName": "template_routes.go",
	"PathPrefix": false,
	"Logger": false,
	"Middleware": false,
	"Verbose": false,
	"OutputMultipleFiles": false,
	"OutputHTMX": false,
	"OutputDatastar": false,
	"OutputExportedDefaultIdentifiers": true,
	"OutputMuxtVersion": true,
	"MultipartMaxMemory": 0,
	"StaticAssetsDirectory": "assets",
	"StaticAssetsPath": "/static",
	"SilenceHTTPResponseWarning": false
}
-- index.gohtml --
{{define "GET /{$}"}}home{{end}}
-- assets/app.css --
p{color:red}
-- server.go --
package server
-- want/error.txt --
--input-static-assets-directory templateRoutesStaticAssets is also the value of --output-template-data-type; change one of them
