An argument used more than once, always passed to parameters of an identical
type -- the same struct form, the same request, or a path value reached first
inside a nested call and again as the outer call's own argument -- declares
its local once, at the first occurrence depth first, and every later
occurrence reuses it.

Command line: muxt generate --use-receiver-type=T
-- config.json --
{
	"MuxtVersion": "v1.2.3",
	"PackageName": "main",
	"PackagePath": "",
	"RoutesFunction": "TemplateRoutes",
	"ReceiverType": "T",
	"ReceiverPackage": "",
	"ReceiverInterface": "RoutesReceiver",
	"TemplateDataType": "TemplateData",
	"SSETemplateDataType": "SSETemplateData",
	"TemplateRoutePathsTypeName": "TemplateRoutePaths",
	"TemplatesVariables": [
		"templates"
	],
	"OutputFileName": "template_routes.go",
	"PathPrefix": false,
	"Logger": false,
	"Middleware": false,
	"Verbose": false,
	"OutputMultipleFiles": false,
	"OutputHTMX": false,
	"OutputDatastar": false,
	"OutputExportedDefaultIdentifiers": true,
	"OutputMuxtVersion": true,
	"MultipartMaxMemory": 0,
	"SilenceHTTPResponseWarning": false
}
-- index.gohtml --
{{define "POST /form Forms(form, form)"}}{{.Result}}{{end}}
{{define "GET /nested/{id} Sum(Double(id), id)"}}{{.Result}}{{end}}
{{define "GET /stream/{sseID} Int(sseID)"}}{{.Result}}{{end}}
{{define "GET /pair/{id} Sum(id, id)"}}{{.Result}}{{end}}
{{define "GET /requests Both(request, request)"}}{{.Result}}{{end}}
{{define "GET /mixed Mixed(request, response, request, response)"}}{{.Result}}{{end}}
-- server.go --
package server

import (
	"io"
	"net/http"
)

type In struct{ Name string }

type T struct{}

func (T) Forms(In, In) any                   { return nil }
func (T) Double(int) int                     { return 0 }
func (T) Sum(int, int) any                   { return nil }
func (T) Int(int) int                        { return 0 }
func (T) Both(*http.Request, *http.Request) any { return nil }
func (T) Mixed(*http.Request, http.ResponseWriter, any, io.Writer) any { return nil }
-- want/log.txt --
warning: GET /mixed uses the response argument, so muxt does not manage this route's status codes, headers, or rendering; silence with MUXT_SILENCE_WARNING_HTTP_RESPONSE_ARGUMENT=true
-- want/template_routes.go --
package server

import (
	"bytes"
	"cmp"
	"errors"
	"fmt"
	"io"
	"log/slog"
	"net/http"
	"path"
	"strconv"
	"sync"
)

type RoutesReceiver interface {
	Forms(In, In) any
	Mixed(*http.Request, http.ResponseWriter, any, io.Writer) any
	Double(int) int
	Sum(int, int) any
	Both(*http.Request, *http.Request) any
	Int(int) int
}

func TemplateRoutes(mux *http.ServeMux, receiver RoutesReceiver) TemplateRoutePaths {
	pathsPrefix := ""
	bytesBufferPool := sync.Pool{New: func() any {
		return bytes.NewBuffer(nil)
	}}
	mux.HandleFunc("POST /form", func(response http.ResponseWriter, request *http.Request) {
		var td = TemplateData[RoutesReceiver, any]{receiver: receiver, response: response, request: request, pathsPrefix: pathsPrefix}
		if err := request.ParseForm(); err != nil {
			http.Error(response, err.Error(), http.StatusBadRequest)
			return
		}
		var form In
		form.Name = request.FormValue("Name")
		buf := bytesBufferPool.Get().(*bytes.Buffer)
		buf.Reset()
		defer bytesBufferPool.Put(buf)
		if len(td.errList) == 0 {
			td.result = receiver.Forms(form, form)
			td.okay = true
		}
		if err := templates.ExecuteTemplate(buf, "POST /form Forms(form, form)", &td); err != nil {
			slog.ErrorContext(request.Context(), "failed to render page", slog.String("path", request.URL.Path), slog.String("pattern", request.Pattern), slog.String("error", err.Error()))
			http.Error(response, "failed to render page", http.StatusInternalServerError)
			return
		}
		defaultStatusCode := http.StatusOK
		if buf.Len() == 0 {
			defaultStatusCode = http.StatusNoContent
		}
		statusCode := cmp.Or(td.statusCode, td.errStatusCode, defaultStatusCode)
		if contentType := response.Header().Get("content-type"); contentType == "" {
			response.Header().Set("content-type", "text/html; charset=utf-8")
		}
		response.Header().Set("content-length", strconv.Itoa(buf.Len()))
		response.WriteHeader(statusCode)
		_, _ = buf.WriteTo(response)
	})
	mux.HandleFunc("GET /mixed", func(response http.ResponseWriter, request *http.Request) {
		var td = TemplateData[RoutesReceiver, any]{receiver: receiver, response: response, request: request, pathsPrefix: pathsPrefix}
		buf := bytesBufferPool.Get().(*bytes.Buffer)
		buf.Reset()
		defer bytesBufferPool.Put(buf)
		if len(td.errList) == 0 {
			td.result = receiver.Mixed(request, response, request, response)
			td.okay = true
		}
		if err := templates.ExecuteTemplate(buf, "GET /mixed Mixed(request, response, request, response)", &td); err != nil {
			slog.ErrorContext(request.Context(), "failed to render page", slog.String("path", request.URL.Path), slog.String("pattern", request.Pattern), slog.String("error", err.Error()))
			http.Error(response, "failed to render page", http.StatusInternalServerError)
			return
		}
		_, _ = buf.WriteTo(response)
	})
	mux.HandleFunc("GET /nested/{id}", func(response http.ResponseWriter, request *http.Request) {
		var td = TemplateData[RoutesReceiver, any]{receiver: receiver, response: response, request: request, pathsPrefix: pathsPrefix}
		idParsed, err := strconv.Atoi(request.PathValue("id"))
		if err != nil {
			td.errList = append(td.errList, err)
			td.errStatusCode = http.StatusBadRequest
		}
		idPathParam := idParsed
		result0 := receiver.Double(idPathParam)
		buf := bytesBufferPool.Get().(*bytes.Buffer)
		buf.Reset()
		defer bytesBufferPool.Put(buf)
		if len(td.errList) == 0 {
			td.result = receiver.Sum(result0, idPathParam)
			td.okay = true
		}
		if err := templates.ExecuteTemplate(buf, "GET /nested/{id} Sum(Double(id), id)", &td); err != nil {
			slog.ErrorContext(request.Context(), "failed to render page", slog.String("path", request.URL.Path), slog.String("pattern", request.Pattern), slog.String("error", err.Error()))
			http.Error(response, "failed to render page", http.StatusInternalServerError)
			return
		}
		defaultStatusCode := http.StatusOK
		if buf.Len() == 0 {
			defaultStatusCode = http.StatusNoContent
		}
		statusCode := cmp.Or(td.statusCode, td.errStatusCode, defaultStatusCode)
		if contentType := response.Header().Get("content-type"); contentType == "" {
			response.Header().Set("content-type", "text/html; charset=utf-8")
		}
		response.Header().Set("content-length", strconv.Itoa(buf.Len()))
		response.WriteHeader(statusCode)
		_, _ = buf.WriteTo(response)
	})
	mux.HandleFunc("GET /pair/{id}", func(response http.ResponseWriter, request *http.Request) {
		var td = TemplateData[RoutesReceiver, any]{receiver: receiver, response: response, request: request, pathsPrefix: pathsPrefix}
		idParsed, err := strconv.Atoi(request.PathValue("id"))
		if err != nil {
			td.errList = append(td.errList, err)
			td.errStatusCode = http.StatusBadRequest
		}
		idPathParam := idParsed
		buf := bytesBufferPool.Get().(*bytes.Buffer)
		buf.Reset()
		defer bytesBufferPool.Put(buf)
		if len(td.errList) == 0 {
			td.result = receiver.Sum(idPathParam, idPathParam)
			td.okay = true
		}
		if err := templates.ExecuteTemplate(buf, "GET /pair/{id} Sum(id, id)", &td); err != nil {
			slog.ErrorContext(request.Context(), "failed to render page", slog.String("path", request.URL.Path), slog.String("pattern", request.Pattern), slog.String("error", err.Error()))
			http.Error(response, "failed to render page", http.StatusInternalServerError)
			return
		}
		defaultStatusCode := http.StatusOK
		if buf.Len() == 0 {
			defaultStatusCode = http.StatusNoContent
		}
		statusCode := cmp.Or(td.statusCode, td.errStatusCode, defaultStatusCode)
		if contentType := response.Header().Get("content-type"); contentType == "" {
			response.Header().Set("content-type", "text/html; charset=utf-8")
		}
		response.Header().Set("content-length", strconv.Itoa(buf.Len()))
		response.WriteHeader(statusCode)
		_, _ = buf.WriteTo(response)
	})
	mux.HandleFunc("GET /requests", func(response http.ResponseWriter, request *http.Request) {
		var td = TemplateData[RoutesReceiver, any]{receiver: receiver, response: response, request: request, pathsPrefix: pathsPrefix}
		buf := bytesBufferPool.Get().(*bytes.Buffer)
		buf.Reset()
		defer bytesBufferPool.Put(buf)
		if len(td.errList) == 0 {
			td.result = receiver.Both(request, request)
			td.okay = true
		}
		if err := templates.ExecuteTemplate(buf, "GET /requests Both(request, request)", &td); err != nil {
			slog.ErrorContext(request.Context(), "failed to render page", slog.String("path", request.URL.Path), slog.String("pattern", request.Pattern), slog.String("error", err.Error()))
			http.Error(response, "failed to render page", http.StatusInternalServerError)
			return
		}
		defaultStatusCode := http.StatusOK
		if buf.Len() == 0 {
			defaultStatusCode = http.StatusNoContent
		}
		statusCode := cmp.Or(td.statusCode, td.errStatusCode, defaultStatusCode)
		if contentType := response.Header().Get("content-type"); contentType == "" {
			response.Header().Set("content-type", "text/html; charset=utf-8")
		}
		response.Header().Set("content-length", strconv.Itoa(buf.Len()))
		response.WriteHeader(statusCode)
		_, _ = buf.WriteTo(response)
	})
	mux.HandleFunc("GET /stream/{sseID}", func(response http.ResponseWriter, request *http.Request) {
		var td = TemplateData[RoutesReceiver, int]{receiver: receiver, response: response, request: request, pathsPrefix: pathsPrefix}
		sseIDParsed, err := strconv.Atoi(request.PathValue("sseID"))
		if err != nil {
			td.errList = append(td.errList, err)
			td.errStatusCode = http.StatusBadRequest
		}
		sseIDPathParam := sseIDParsed
		buf := bytesBufferPool.Get().(*bytes.Buffer)
		buf.Reset()
		defer bytesBufferPool.Put(buf)
		if len(td.errList) == 0 {
			td.result = receiver.Int(sseIDPathParam)
			td.okay = true
		}
		if err := templates.ExecuteTemplate(buf, "GET /stream/{sseID} Int(sseID)", &td); err != nil {
			slog.ErrorContext(request.Context(), "failed to render page", slog.String("path", request.URL.Path), slog.String("pattern", request.Pattern), slog.String("error", err.Error()))
			http.Error(response, "failed to render page", http.StatusInternalServerError)
			return
		}
		defaultStatusCode := http.StatusOK
		if buf.Len() == 0 {
			defaultStatusCode = http.StatusNoContent
		}
		statusCode := cmp.Or(td.statusCode, td.errStatusCode, defaultStatusCode)
		if contentType := response.Header().Get("content-type"); contentType == "" {
			response.Header().Set("content-type", "text/html; charset=utf-8")
		}
		response.Header().Set("content-length", strconv.Itoa(buf.Len()))
		response.WriteHeader(statusCode)
		_, _ = buf.WriteTo(response)
	})
	return TemplateRoutePaths{Route: TemplateRouteBuilder{pathsPrefix: pathsPrefix}}
}

type TemplateData[R any, T any] struct {
	receiver      R
	response      http.ResponseWriter
	request       *http.Request
	result        T
	statusCode    int
	errStatusCode int
	okay          bool
	errList       []error
	redirectURL   string
	pathsPrefix   string
}

func (data *TemplateData[R, T]) MuxtVersion() string {
	const muxtVersion = "v1.2.3"
	return muxtVersion
}

func (data *TemplateData[R, T]) Path() TemplateRoutePaths {
	return TemplateRoutePaths{Route: TemplateRouteBuilder{pathsPrefix: data.pathsPrefix}}
}

func (data *TemplateData[R, T]) Result() T {
	return data.result
}

func (data *TemplateData[R, T]) Request() *http.Request {
	return data.request
}

func (data *TemplateData[R, T]) StatusCode(statusCode int) *TemplateData[R, T] {
	data.statusCode = statusCode
	return data
}

func (data *TemplateData[R, T]) Header(key, value string) *TemplateData[R, T] {
	data.response.Header().Set(key, value)
	return data
}

func (data *TemplateData[R, T]) Ok() bool {
	return data.okay
}

func (data *TemplateData[R, T]) Err() error {
	return errors.Join(data.errList...)
}

func (data *TemplateData[R, T]) Receiver() R {
	return data.receiver
}

func (data *TemplateData[R, T]) Redirect(url string, code int) (*TemplateData[R, T], error) {
	if code < 300 || code >= 400 {
		return data, fmt.Errorf("invalid status code %d for redirect", code)
	}
	data.redirectURL = url
	return data.StatusCode(code), nil
}

func (data *TemplateData[R, T]) RedirectMultipleChoices(url string) (*TemplateData[R, T], error) {
	return data.Redirect(url, http.StatusMultipleChoices)
}

func (data *TemplateData[R, T]) RedirectMovedPermanently(url string) (*TemplateData[R, T], error) {
	return data.Redirect(url, http.StatusMovedPermanently)
}

func (data *TemplateData[R, T]) RedirectFound(url string) (*TemplateData[R, T], error) {
	return data.Redirect(url, http.StatusFound)
}

func (data *TemplateData[R, T]) RedirectSeeOther(url string) (*TemplateData[R, T], error) {
	return data.Redirect(url, http.StatusSeeOther)
}

func (data *TemplateData[R, T]) String() string {
	return ""
}

type TemplateRoutePaths struct {
	Route TemplateRouteBuilder
}
type TemplateRouteBuilder struct {
	pathsPrefix string
}
type TemplateRoute struct {
	method string
	path   string
}

func (route TemplateRoute) String() string {
	return route.path
}

func (route TemplateRoute) Method() string {
	return route.method
}

func (routes TemplateRouteBuilder) Forms() TemplateRoute {
	return TemplateRoute{method: "POST", path: path.Join(cmp.Or(routes.pathsPrefix, "/"), "form")}
}

func (routePaths TemplateRoutePaths) Forms() string {
	return routePaths.Route.Forms().String()
}

func (routes TemplateRouteBuilder) Mixed() TemplateRoute {
	return TemplateRoute{method: "GET", path: path.Join(cmp.Or(routes.pathsPrefix, "/"), "mixed")}
}

func (routePaths TemplateRoutePaths) Mixed() string {
	return routePaths.Route.Mixed().String()
}

func (routes TemplateRouteBuilder) ReadNestedByIDCallingSum(idPathParam int) TemplateRoute {
	return TemplateRoute{method: "GET", path: path.Join(cmp.Or(routes.pathsPrefix, "/"), "nested", strconv.Itoa(idPathParam))}
}

func (routePaths TemplateRoutePaths) ReadNestedByIDCallingSum(idPathParam int) string {
	return routePaths.Route.ReadNestedByIDCallingSum(idPathParam).String()
}

func (routes TemplateRouteBuilder) ReadPairByIDCallingSum(idPathParam int) TemplateRoute {
	return TemplateRoute{method: "GET", path: path.Join(cmp.Or(routes.pathsPrefix, "/"), "pair", strconv.Itoa(idPathParam))}
}

func (routePaths TemplateRoutePaths) ReadPairByIDCallingSum(idPathParam int) string {
	return routePaths.Route.ReadPairByIDCallingSum(idPathParam).String()
}

func (routes TemplateRouteBuilder) Both() TemplateRoute {
	return TemplateRoute{method: "GET", path: path.Join(cmp.Or(routes.pathsPrefix, "/"), "requests")}
}

func (routePaths TemplateRoutePaths) Both() string {
	return routePaths.Route.Both().String()
}

func (routes TemplateRouteBuilder) Int(sseIDPathParam int) TemplateRoute {
	return TemplateRoute{method: "GET", path: path.Join(cmp.Or(routes.pathsPrefix, "/"), "stream", strconv.Itoa(sseIDPathParam))}
}

func (routePaths TemplateRoutePaths) Int(sseIDPathParam int) string {
	return routePaths.Route.Int(sseIDPathParam).String()
}
