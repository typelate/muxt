-- go.mod --
module example.com/app

go 1.26

require github.com/typelate/htt v0.0.0

replace github.com/typelate/htt => ../../../..
-- main.go --
package main

import (
	"embed"

	"github.com/typelate/htt/template"
)

//go:embed *.gohtml
var files embed.FS

var templates = template.Must(template.New("app").Funcs(template.FuncMap{
	"greet": func() string { return "hi" },
}).ParseFS(files, "*.gohtml"))
-- index.gohtml --
{{define "home"}}{{greet}}{{end}}
