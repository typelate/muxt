An ExecuteTemplate call naming a template the set does not define.

Command line: muxt check
-- config.json --
{
	"Verbose": false,
	"TemplatesVariables": [
		"templates"
	]
}
-- index.gohtml --
{{define "main"}}{{end}}
-- server.go --
package server

import "io"

type Page struct {
	Title string
	Items []Item
}

type Item struct {
	Name  string
	Price int
}

func RenderIndex(w io.Writer, page Page) error {
	return templates.ExecuteTemplate(w, "index", page)
}

