With -v, each error is followed by the declaration of the type the field
or method was looked up on.

Command line: muxt check -v
-- config.json --
{
	"Verbose": true,
	"TemplatesVariables": [
		"templates"
	]
}
-- pages.gohtml --
{{define "intakes"}}<h1>Intakes</h1>{{template "footer" .}}{{end}}
{{define "users"}}<h1>Users</h1>{{template "footer" .}}{{end}}
{{define "settings"}}<h1>Settings</h1>{{template "footer" .}}{{end}}
{{define "login"}}<h1>Login</h1>{{template "footer" .}}{{end}}
-- footer.gohtml --
{{define "footer"}}<footer>{{.Viewer}}</footer>{{end}}
-- server.go --
package server

import "io"

type AdminPage struct {
	Title    string
	Subtitle string
	Rows     []string
	Total    int
}

type LoginPage struct {
	Next string
}

func Intakes(w io.Writer, page AdminPage) error {
	return templates.ExecuteTemplate(w, "intakes", page)
}

func Users(w io.Writer, page AdminPage) error {
	return templates.ExecuteTemplate(w, "users", page)
}

func Settings(w io.Writer, page AdminPage) error {
	return templates.ExecuteTemplate(w, "settings", page)
}

func Login(w io.Writer, page LoginPage) error {
	return templates.ExecuteTemplate(w, "login", page)
}
