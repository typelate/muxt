A template nothing executes is reported; a route template is reported
as waiting for muxt generate, and a partial only it uses is not reported.

Command line: muxt check
-- config.json --
{
	"Verbose": false,
	"TemplatesVariables": [
		"templates"
	]
}
-- index.gohtml --
{{define "index"}}<h1>{{.Title}}</h1>{{end}}
{{define "orphan"}}<p>never rendered</p>{{end}}
{{define "GET /items Items()"}}{{template "row" .}}{{end}}
{{define "row"}}<tr></tr>{{end}}
-- server.go --
package server

import "io"

type Page struct {
	Title string
	Items []Item
}

type Item struct {
	Name  string
	Price int
}

func RenderIndex(w io.Writer, page Page) error {
	return templates.ExecuteTemplate(w, "index", page)
}

