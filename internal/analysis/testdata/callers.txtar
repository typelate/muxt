Where each template is executed or called from, with the data type.
-- index.gohtml --
{{define "page"}}{{template "header" .Title}}{{range .Items}}{{template "item" .}}{{end}}{{end}}
{{define "header"}}<h1>{{.}}</h1>{{end}}
{{define "item"}}<li>{{.Name}}</li>{{end}}
{{define "alone"}}{{template "header" "Alone"}}{{end}}
-- server.go --
package server

import "io"

type Page struct {
	Title string
	Items []Item
}

type Item struct{ Name string }

func Render(w io.Writer, page Page) error {
	return templates.ExecuteTemplate(w, "page", page)
}

func RenderAlone(w io.Writer) error {
	return templates.ExecuteTemplate(w, "alone", nil)
}
