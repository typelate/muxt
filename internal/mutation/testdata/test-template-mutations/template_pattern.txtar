--template-pattern limits mutation to the templates it matches; the
traversal still passes through the others to reach them.

Command line: muxt test-template-mutations --dry-run --seed=1 -v --template-pattern=^footer$
-- config.json --
{
	"TemplatesVariables": [
		"templates"
	],
	"TemplatePattern": "^footer$",
	"Run": null,
	"Packages": [],
	"DryRun": true,
	"Verbose": true,
	"IncludeTests": false,
	"Seed": 1,
	"SeedSet": true,
	"MaxCases": 8,
	"Workers": 1,
	"Diff": "",
	"GoTestArgs": null
}
-- server.go --
package server

import (
	"embed"
	"html/template"
	"io"
)

//go:embed *.gohtml
var templateFiles embed.FS

var templates = template.Must(template.ParseFS(templateFiles, "*.gohtml"))

type Page struct{ Title string }

func RenderPage(w io.Writer, page Page) error {
	return templates.ExecuteTemplate(w, "page", page)
}
-- page.gohtml --
{{define "page"}}<h1>{{.Title}}</h1>{{template "footer" .}}{{end}}
{{define "footer"}}<footer>{{.Title}}</footer>{{end}}
-- want/report.txt --
