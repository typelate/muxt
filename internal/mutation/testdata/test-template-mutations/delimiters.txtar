-- server.go --
package server

import (
	"html/template"
	"io"
)

var templates = template.Must(template.New("page").Delims("[[", "]]").Parse(`[[define "note"]]<p>[[.]]</p>[[end]]`))

func RenderNote(w io.Writer, note string) error {
	return templates.ExecuteTemplate(w, "note", note)
}
