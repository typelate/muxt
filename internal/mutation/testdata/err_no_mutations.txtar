Templates that were reached but hold no action to vary are an error, not
a pass.

Command line: muxt test-template-mutations --dry-run --seed=1
-- config.json --
{
	"command": "test-template-mutations",
	"config": {
		"TemplatesVariables": [
			"templates"
		],
		"TemplatePattern": "",
		"Run": "",
		"Packages": [],
		"DryRun": true,
		"Verbose": false,
		"IncludeTests": false,
		"Seed": 1,
		"SeedSet": true,
		"MaxCases": 8,
		"Workers": 1,
		"Diff": "",
		"GoTestArgs": null
	}
}
-- server.go --
package server

import (
	"embed"
	"html/template"
	"io"
)

//go:embed *.gohtml
var templateFiles embed.FS

var templates = template.Must(template.ParseFS(templateFiles, "*.gohtml"))

func RenderPage(w io.Writer) error {
	return templates.ExecuteTemplate(w, "page", nil)
}
-- page.gohtml --
{{define "page"}}<p>static</p>{{end}}
