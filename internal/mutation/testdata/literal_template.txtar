A template written as a Go string literal: its actions and branches are
mutated where they are written in the literal.
-- server.go --
package server

import (
	"html/template"
	"io"
)

var templates = template.Must(template.New("greeting").Parse(`Hello, {{.Name}}!{{if .Loud}} !!!{{end}}`))

type Greeting struct {
	Name string
	Loud bool
}

func Render(w io.Writer, greeting Greeting) error {
	return templates.ExecuteTemplate(w, "greeting", greeting)
}
