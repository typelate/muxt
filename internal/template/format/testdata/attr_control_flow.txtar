-- input.gohtml --
<div {{if .Show}}class="a"{{end}}>text</div>
<div {{if .Show}}class="visible"{{else}}class="hidden"{{end}}>text</div>
<div class="{{.Class}}">text</div>
<div class={{.Class}}>text</div>
<input {{if .Active}}checked{{end}} type="text">
<div {{if .Show}}class="a" id="b"{{end}}>text</div>
<div {{if .Show}}class="a"{{end}} id="main">text</div>
<a href="{{.URL}}">{{.Label}}</a>
<div {{if .A}}class="a"{{else if .B}}class="b"{{else}}class="c"{{end}}>text</div>
