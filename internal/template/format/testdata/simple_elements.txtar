-- input.gohtml --
<p>
  You are about to create a portfolio.
  This will be your new landing page.
</p>
<div><p>
  line one
  line two
</p></div>
<div></div>
<p>hello</p>
<div><p>hello</p><p>world</p></div>
<div><section><p>text</p></section></div>
<br>
<br/>
<img src="test.png">
<img src="photo.jpg"><br>
<p><strong>bold</strong> text</p>
<p>hello <span>world</span></p>
<p><a href="#">link</a></p>
<p><em><strong>bold italic</strong></em></p>
<div class="foo">text</div>
<div class="foo" id="bar">text</div>
<div class="foo" id="bar" data-x="1">text</div>
<section><div><p>nested</p></div></section>
<ul><li>one</li><li>two</li></ul>
<p>text with <strong>bold</strong> and <em>italic</em></p>
<div class="container" id="main"><p>inside</p></div>
<header><h1>Title</h1></header><main><p>body</p></main>
<div>
  <p>a</p>
  <p>b</p>
</div>
<p>{{.Name}}</p>
<td>{{.Value}}</td>
<!-- hello -->
{{/* a comment */}}
<!DOCTYPE html>
<!DOCTYPE html><html><body><p>hi</p></body></html>
