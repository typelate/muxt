Defines and a block that hold self-closed elements which are not void,
each rendered only in SVG or MathML content: called inside svg, called
by a define that is, standing inside svg, called inside math. The slash
closes there, so the file formats. Before the formatter followed a body
to the places the file renders it, any such define left the whole file
as written.
-- input.gohtml --
<div><p>Icons</p>
<svg viewBox="0 0 24 24">{{template "icon-check"}}</svg>
<svg viewBox="0 0 24 24">{{block "icon-close" .}}<path d="M6 6l12 12"/><path d="M18 6L6 18"/>{{end}}</svg>
<math>{{template "space"}}</math></div>

{{define "icon-check"}}
<path d="M5 12l5 5L20 7"/>
<g>{{template "dot"}}</g>
{{end}}

{{define "dot"}}<circle cx="12" cy="12" r="1"/>{{end}}

{{define "space"}}<mspace width="1em"/>{{end}}
-- format.gohtml --
<div><p>Icons</p>
	<svg viewBox="0 0 24 24">{{template "icon-check"}}</svg>
	<svg viewBox="0 0 24 24">{{block "icon-close" .}}<path d="M6 6l12 12"/><path d="M18 6L6 18"/>{{end}}</svg>
	<math>{{template "space"}}</math></div>

{{define "icon-check"}}
<path d="M5 12l5 5L20 7"/>
<g>{{template "dot"}}</g>
{{end}}

{{define "dot"}}<circle cx="12" cy="12" r="1"/>{{end}}

{{define "space"}}<mspace width="1em"/>{{end}}
