-- input.gohtml --
{{define "header"}}<header><h1>{{.Title}}</h1></header>{{end}}
{{define "comp"}}{{.Value}}{{end}}
{{define "empty"}}{{end}}
<td>{{template "comp" .X}}</td>
-- format.gohtml --
{{define "header" -}}
	<header><h1>{{.Title}}</h1></header>
{{- end}}

{{define "comp"}}{{.Value}}{{end}}

{{define "empty"}}{{end}}
<td>{{template "comp" .X}}</td>
