-- input.gohtml --
<div>
  <p>first</p>


  <p>second</p>



  <p>third</p>
</div>
<pre>  line one

  line two

  line three  </pre>
<textarea>  keep
  all

  blank

  lines  </textarea>
{{if .Show}}
  <p>a</p>

  <p>b</p>
{{end}}
<div>
  <p>trailing spaces above</p>
  <p>trailing tab above</p>
</div>
