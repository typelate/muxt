{{define "page" -}}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>{{.Title}} - My App</title>
    <style>
        body { color: {{.TextColor}}; }
        .container { max-width: 960px; }
        /* handle < and > in comments */
        h1 > span { font-weight: bold; }
        p + p { margin-top: 1em; }
    </style>
</head>
<body>
    <h1>{{.Title}}</h1>
    <div id="content">{{.Content}}</div>

    <textarea id="template-source" rows="10" cols="80">{{.DefaultText}}</textarea>

    <script>
        var config = {{.JSONConfig}};
        if (config.count < 10) {
            console.log("less than 10");
        }
        document.getElementById("content").innerHTML = config.html;
    </script>

    {{if .ExtraScript}}
    <script src="{{.ExtraScriptSrc}}">
    </script>
    {{end}}
</body>
</html>
{{- end}}
