{{define "GET / List(ctx)"}}<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Datastar Todo</title>
	<script type="module" src="https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.0/bundles/datastar.js"
	        integrity="sha384-LGcfj7EQR2KZk4GdiKJsUD4nFWrKrLCk/gZXLnPBBf2p/QmoaYYFuyitCwDqhgW1"
	        crossorigin="anonymous"></script>
	<style>
		:root {
			--bg: #f4f4f5;
			--card: #ffffff;
			--ink: #18181b;
			--muted: #71717a;
			--edge: #e4e4e7;
			--accent: #0ea5e9;
			--done: #a1a1aa;
		}
		* { box-sizing: border-box; }
		body {
			margin: 0;
			min-height: 100vh;
			display: grid;
			place-items: start center;
			padding-top: 8vh;
			background: var(--bg);
			color: var(--ink);
			font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
		}
		main {
			width: min(34rem, 92vw);
			background: var(--card);
			border: 1px solid var(--edge);
			border-radius: 16px;
			box-shadow: 0 8px 24px rgb(0 0 0 / 0.06);
			overflow: hidden;
		}
		header {
			padding: 1.5rem 1.75rem 0;
		}
		h1 {
			margin: 0 0 1rem;
			font-size: 1.125rem;
			font-weight: 600;
			letter-spacing: 0.02em;
			text-transform: uppercase;
			color: var(--muted);
		}
		form {
			display: flex;
			gap: 0.5rem;
			padding: 0 1.75rem 1.25rem;
		}
		input[type="text"] {
			flex: 1;
			font: inherit;
			padding: 0.6rem 0.8rem;
			border: 1px solid var(--edge);
			border-radius: 10px;
			outline-color: var(--accent);
		}
		form button {
			font: inherit;
			font-weight: 600;
			padding: 0.6rem 1.1rem;
			color: #fff;
			background: var(--accent);
			border: 1px solid var(--accent);
			border-radius: 10px;
			cursor: pointer;
		}
		form button:hover { filter: brightness(1.08); }
		ul {
			list-style: none;
			margin: 0;
			padding: 0;
			border-top: 1px solid var(--edge);
		}
		li {
			display: flex;
			align-items: center;
			gap: 0.75rem;
			padding: 0.8rem 1.75rem;
			border-bottom: 1px solid var(--edge);
		}
		li input[type="checkbox"] {
			width: 1.15rem;
			height: 1.15rem;
			accent-color: var(--accent);
			cursor: pointer;
		}
		li label { flex: 1; }
		li.done label {
			color: var(--done);
			text-decoration: line-through;
		}
		li button {
			font-size: 1rem;
			line-height: 1;
			padding: 0.3rem 0.55rem;
			color: var(--muted);
			background: none;
			border: none;
			border-radius: 8px;
			cursor: pointer;
			visibility: hidden;
		}
		li:hover button { visibility: visible; }
		li button:hover { color: #dc2626; background: #fef2f2; }
		footer {
			padding: 0.9rem 1.75rem;
			font-size: 0.85rem;
			color: var(--muted);
		}
	</style>
</head>
<body>
	<main>
		<header>
			<h1>Todos</h1>
		</header>
		<form data-on:submit="evt.preventDefault(); @post('/todos', {contentType: 'form'}); el.reset()">
			<input type="text" name="title" placeholder="What needs doing?" autocomplete="off" required>
			<button type="submit">Add</button>
		</form>
		{{template "sseTodos" .}}
	</main>
</body>
</html>
{{end}}

{{define "sseTodos"}}<ul id="todo-list">
{{- range .Result.Items}}
	<li{{if .Done}} class="done"{{end}}>
		<input type="checkbox" data-on:change="@post('/todos/{{.ID}}/toggle')"{{if .Done}} checked{{end}} aria-label="toggle">
		<label>{{.Title}}</label>
		<button data-on:click="@delete('/todos/{{.ID}}')" aria-label="delete">✕</button>
	</li>
{{- end}}
</ul>
<footer id="todo-footer">{{.Result.Remaining}} of {{.Result.Total}} remaining</footer>{{end}}

{{define "POST /todos sse(CreateTodo(ctx, form, sseTodos))"}}{{end}}

{{define "POST /todos/{id}/toggle sse(ToggleTodo(ctx, id, sseTodos))"}}{{end}}

{{define "DELETE /todos/{id} sse(DeleteTodo(ctx, id, sseTodos))"}}{{end}}
